<script>
(function(){
  var r=document.documentElement,b=document.getElementById('tg');
  try{var s=localStorage.getItem('aux-theme');if(s==='dark'||s==='light')r.setAttribute('data-theme',s);}catch(e){}
  function sync(){b.setAttribute('aria-checked',r.getAttribute('data-theme')==='dark'?'true':'false');}
  sync();
  b.addEventListener('click',function(){
    var n=r.getAttribute('data-theme')==='dark'?'light':'dark';r.setAttribute('data-theme',n);sync();
    try{localStorage.setItem('aux-theme',n);}catch(e){}
  });
})();
</script>
