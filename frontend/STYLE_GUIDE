[data-theme="dark"]{--purple:#6a4778;--purple-hover:#7d5a8c;--purple-soft:#2a2030;--white:#ffffff;--surface:#121212;--surface-alt:#1e1e1e;--ink:#f2f2f2;--ink-muted:#a3a3a3;--line:#2e2e2e;--line-strong:#6b6b6b;--primary:#6a4778;--on-primary:#ffffff;--link:#b593c4;--focus-ring:#b593c4;--danger:#f97066;--success:#6ccb9a}
