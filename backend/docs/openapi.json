          "username" : {
            "type" : "string",
            "example" : "justin"
          },
          "profilePictureUrl" : {
            "type" : "string",
            "example" : "/uploads/users/u_41x9.jpg"
          },
          "onboardingStep" : {
            "type" : "string",
