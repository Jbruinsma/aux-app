    "/api/users/me/banner" : {
      "put" : {
        "tags" : [ "user-controller" ],
        "summary" : "Replace the caller's banner image",
        "description" : "Multipart field `file`: the ORIGINAL JPEG or PNG (do not crop on the frontend), at most 5MB and\n25 megapixels, at least 600x200. Plus `cropX`, `cropY`, `cropWidth`, `cropHeight`: the 3:1 area\nthe user framed, in pixels of the original image as displayed (after EXIF rotation).\nThe server crops to that area, resizes down to at most 1500x500 (never upscales), and stores it\nas WebP. Returns the new public URL.\n",
        "operationId" : "updateBanner",
        "parameters" : [ {
          "name" : "cropX",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
