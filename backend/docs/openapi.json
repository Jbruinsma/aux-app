  "components" : {
    "schemas" : {
      "ProfilePictureUpdate" : {
        "type" : "object",
        "properties" : {
          "profilePictureUrl" : {
            "type" : "string",
            "example" : "https://media.example.com/pfp/3f2b8c1e-8d4a-4c6e-9a51-2f0d7b9e6c11.webp"
          }
        }
      },
      "UserSummary" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "string",
            "example" : "u_41x9"
