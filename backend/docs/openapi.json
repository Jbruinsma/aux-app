  } ],
  "paths" : {
    "/api/users/me/profile-picture" : {
      "put" : {
        "tags" : [ "user-controller" ],
        "summary" : "Replace the caller's profile picture",
        "description" : "Multipart field `file`: a JPEG or PNG, at most 5MB and 25 megapixels, at least 256x256.\nSend the original image; do NOT crop it on the frontend. The server applies EXIF rotation,\ncenter-crops to a square, resizes to at most 1024x1024, and stores it as WebP.\nReturns the new public URL.\n",
        "operationId" : "updateProfilePicture",
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "format" : "binary"
                  }
                },
                "required" : [ "file" ]
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfilePictureUpdate"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid or malformed body (codes INVALID_FIELD, MALFORMED_BODY)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid token (code INVALID_TOKEN)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          },
          "413" : {
            "description" : "Over 5MB or 25 megapixels (code IMAGE_TOO_LARGE)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          },
          "415" : {
            "description" : "Not a JPEG or PNG (code UNSUPPORTED_IMAGE_TYPE)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          },
          "500" : {
            "description" : "Unexpected server error (code INTERNAL_ERROR)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
    "/api/users/onboarding/step" : {
      "post" : {
        "tags" : [ "user-controller" ],
        "summary" : "Complete an onboarding step",
        "description" : "Steps must be completed in order (USERNAME, PFP). Send the step the user is currently on.\n- `step=USERNAME`: also send form field `username` (3-16 chars: letters, numbers, underscore).\n- `step=PFP`: also send multipart field `file` (same rules as PUT /me/profile-picture).\nReturns the updated user; `onboardingStep` is the next step, or `DONE` when finished.\n",
        "operationId" : "completeOnboardingStep",
        "parameters" : [ {
          "name" : "step",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string",
            "enum" : [ "USERNAME", "PFP", "DONE" ]
          }
        }, {
          "name" : "username",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "format" : "binary"
                  }
                }
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "Step accepted; body is the updated user",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserSummary"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid or malformed body (codes INVALID_FIELD, MALFORMED_BODY)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          },
          "409" : {
            "description" : "Username taken (code USERNAME_TAKEN)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid token (code INVALID_TOKEN)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          },
          "500" : {
            "description" : "Unexpected server error (code INTERNAL_ERROR)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          }
        },
        "security" : [ {
          "bearerAuth" : [ ]
        } ]
      }
    },
