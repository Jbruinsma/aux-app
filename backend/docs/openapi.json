    "/api/users/me/profile-picture" : {
      "put" : {
        "tags" : [ "user-controller" ],
        "summary" : "Replace the caller's profile picture",
        "description" : "Multipart field `file`: a JPEG or PNG, at most 5MB and 25 megapixels, at least 256x256.\nSend the original image; do NOT crop it on the frontend. The server applies EXIF rotation,\ncenter-crops to a square, resizes to at most 1024x1024, and stores it as WebP.\nReturns the new public URL.\n",
        "operationId" : "updateProfilePicture",
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "format" : "binary"
                  }
                },
                "required" : [ "file" ]
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProfilePictureUpdate"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid or malformed body (codes INVALID_FIELD, MALFORMED_BODY)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          },
          "401" : {
            "description" : "Missing or invalid token (code INVALID_TOKEN)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          },
          "413" : {
            "description" : "Over 5MB or 25 megapixels (code IMAGE_TOO_LARGE)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          },
          "415" : {
            "description" : "Not a JPEG or PNG (code UNSUPPORTED_IMAGE_TYPE)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuxServerError"
                }
              }
            }
          },
          "500" : {
