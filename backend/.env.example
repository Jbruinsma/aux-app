# Copy to .env and fill in. Generate a secret with: openssl rand -base64 48
AUX_JWT_SECRET=

# Cloudflare R2 (S3 API). One token per bucket, each scoped to Object Read & Write on that bucket only.
# public-base-url is the image bucket's custom domain, e.g. https://media.example.com
# The audio bucket must stay private: no custom domain, no r2.dev URL
AUX_R2_ACCOUNT_ID=
AUX_R2_ACCESS_KEY_ID=
AUX_R2_SECRET_ACCESS_KEY=
AUX_R2_BUCKET=
AUX_R2_PUBLIC_BASE_URL=
AUX_PRIVATE_TRACKS_R2_ACCESS_KEY_ID=
AUX_PRIVATE_TRACKS_R2_SECRET_ACCESS_KEY=
AUX_PRIVATE_TRACKS_R2_BUCKET=
