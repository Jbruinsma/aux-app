# Copy to .env and fill in. Generate a secret with: openssl rand -base64 48
AUX_JWT_SECRET=

# Cloudflare R2 (S3 API). Token scoped to Object Read & Write on the bucket only.
# public-base-url is the bucket's custom domain, e.g. https://media.example.com
AUX_R2_ACCOUNT_ID=
AUX_R2_ACCESS_KEY_ID=
AUX_R2_SECRET_ACCESS_KEY=
AUX_R2_BUCKET=
AUX_R2_PUBLIC_BASE_URL=
